{
  "name": "paiger",
  "version": "0.5.0",
  "description": "A React component library with CSS custom property theming",
  "keywords": [
    "react",
    "ui",
    "components",
    "component-library",
    "css-variables",
    "theming"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "Rio",
  "homepage": "https://serialexperimentsrio.github.io/paiger/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serialexperimentsrio/paiger.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "playwright test",
    "prepublishOnly": "bun run build",
    "demo:dev": "cd demo && bun run dev",
    "demo:build": "cd demo && bun run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.27.4",
    "esbuild-css-modules-plugin": "^3.1.5",
    "typescript": "^6"
  }
}
